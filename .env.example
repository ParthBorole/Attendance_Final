# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AttendSecure Environment Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=attendsecure_production_secret_key_tsdc_2026_jwt_token_auth

# Resend.com Official Email API Configuration (Instant OTP to Gmail)
# Get your free API key at https://resend.com
RESEND_API_KEY=""
RESEND_FROM="AttendSecure <onboarding@resend.dev>"

# Institution Default Geolocation (Thakur Shyamnarayan Degree College, Kandivali East)
VITE_DEFAULT_LAT=19.2138050
VITE_DEFAULT_LNG=72.8648100
VITE_COLLEGE_NAME="Thakur Shyamnarayan Degree College (TSDC), Kandivali (East)"

# Google Maps Platform API Key for Campus & Attendance Radius Visualization
VITE_GOOGLE_MAPS_API_KEY=""

# Optional SMTP Configuration Fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AttendSecure TSDC <noreply@tsdc.edu.in>"
